# Free Traveler — 환경변수 예시 (REQ-NF-016)
#
# 이 파일은 실제 비밀값을 담지 않는다. 로컬 개발 시 `.env.local`로 복사한 뒤
# 각자의 값을 채운다(`.env.local`은 .gitignore에 의해 저장소에 커밋되지 않는다).
# 비밀키는 클라이언트 번들에 포함되지 않아야 한다 — `NEXT_PUBLIC_` 접두사가 붙은
# 값만 브라우저로 노출되며, 그 외 값은 서버 전용으로 유지한다.

# --- Supabase (Auth + PostgreSQL, docs/ARCHITECTURE.md §7~9) ---
# Client(Browser)/Server 양쪽에서 사용자 세션 권한으로 Supabase에 접근할 때 필요하다.
# Anon Key는 RLS(Row Level Security)로 보호되므로 공개되어도 안전하도록 설계된 값이다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 외부 이동 허용 URL (REQ-FUNC-016/018/024/026, docs/ARCHITECTURE.md 89행) ---
# 항공편/숙소 탭에서 새 탭(target=_blank, noopener,noreferrer)으로만 이동한다.
# 목적지·날짜 등 사용자 입력값은 이 URL의 Query Parameter로 붙이지 않는다.
FLIGHT_OUTBOUND_URL=
HOTEL_OUTBOUND_URL=
