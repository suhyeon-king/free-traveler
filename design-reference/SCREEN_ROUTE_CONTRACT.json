  "technical_routes": [
    {
      "path": "/auth/callback",
      "type": "auth_callback",
      "counted_as_screen": false,
      "purpose": "Supabase Auth 이메일 인증·로그인 콜백 처리"
    },
    {
      "path": "/api/*",
      "type": "api_route",
      "counted_as_screen": false,
      "purpose": "동행글/참가요청/신고/차단/관리자 신고 상태·외부 URL 설정 등 서버 액션·API Route (항공·호텔 폼은 API Route 없이 클라이언트 상태로만 처리)"
    },
    {
      "path": "not-found",
      "type": "error_route",
      "counted_as_screen": false,
      "purpose": "404 처리 (src/app/not-found.tsx), 홈/이전/재시도 복구 행동 포함"
    }
